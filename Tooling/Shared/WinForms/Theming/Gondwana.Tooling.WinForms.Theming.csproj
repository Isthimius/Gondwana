<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Dpi/*.cs" Link="Dpi/%(Filename)%(Extension)" />
    <Compile Include="../Navigation/*.cs" Link="Navigation/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Gondwana.Tooling.Studio.WinForms.Tests" />
    <PackageReference Include="DockPanelSuite" Version="3.1.1" />
    <PackageReference Include="DockPanelSuite.ThemeVS2015" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared artwork for Studio and standalone WinForms editors. -->
    <EmbeddedResource Include="assets/icons8-folder-96.png"
                      LogicalName="Gondwana.Tooling.WinForms.Theming.assets.icons8-folder-96.png" />
    <!-- The image is loaded from this assembly, never from a loose output asset. -->
    <None Update="assets/icons8-folder-96.png"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="assets/icons8-pack-luggage-96.png"
                      LogicalName="Gondwana.Tooling.WinForms.Theming.assets.icons8-pack-luggage-96.png" />
    <None Update="assets/icons8-pack-luggage-96.png"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
