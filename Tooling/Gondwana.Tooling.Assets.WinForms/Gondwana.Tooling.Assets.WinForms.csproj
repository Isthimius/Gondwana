<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Retain SystemAware until mixed-monitor docking/canvas compatibility is verified. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/WinForms/UndoRedoMenu.cs" Link="Editing/UndoRedoMenu.cs" />
    <Compile Include="../Shared/WinForms/WorkspaceSessionStore.cs" Link="Session/WorkspaceSessionStore.cs" />
    <Compile Include="../Shared/WinForms/WorkspaceSessionController.cs" Link="Session/WorkspaceSessionController.cs" />
    <Compile Include="..\Shared\WinForms\EditorDockWorkspace.cs" Link="Docking\EditorDockWorkspace.cs" />
    <Compile Include="..\Shared\WinForms\DockLayoutStore.cs" Link="Docking\DockLayoutStore.cs" />
    <Compile Include="..\Shared\WinForms\DockLayoutPersistence.cs" Link="Docking\DockLayoutPersistence.cs" />
    <PackageReference Include="DockPanelSuite" Version="3.1.1" />
    <PackageReference Include="DockPanelSuite.ThemeVS2015" Version="3.1.1" />
    <ProjectReference Include="..\..\Gondwana\Gondwana.csproj" />
  </ItemGroup>

  <ItemGroup><ProjectReference Include="../Gondwana.Tooling.Assets/Gondwana.Tooling.Assets.csproj" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/WinForms/Theming/Gondwana.Tooling.WinForms.Theming.csproj" />
    <Using Include="Gondwana.Tooling.WinForms.Theming" />
  </ItemGroup>
</Project>
