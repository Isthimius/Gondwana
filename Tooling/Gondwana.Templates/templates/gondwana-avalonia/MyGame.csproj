<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
            These versions track the latest Gondwana 2.x releases.
            Run 'dotnet add package Gondwana' to update to a newer major version.
        -->
        <PackageReference Include="Gondwana" Version="2.*" />
        <PackageReference Include="Gondwana.Hosting" Version="2.*" />
        <PackageReference Include="Gondwana.Avalonia" Version="2.*" />
        <PackageReference Include="Gondwana.Avalonia.Hosting" Version="2.*" />
        <!--
            Avalonia.Desktop provides the AppBuilder.UsePlatformDetect() bootstrapper
            for Windows, macOS, and Linux desktop targets.
        -->
        <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    </ItemGroup>

    <!--
        Add your asset files here so they are copied to the output directory.
        Example:
        <ItemGroup>
            <Content Include="assets\my-sprite.png">
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
    -->

</Project>
