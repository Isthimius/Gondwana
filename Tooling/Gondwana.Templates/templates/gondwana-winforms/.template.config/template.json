{
  "$schema": "http://json.schemastore.org/template",
  "author": "Michael Adkins",
  "classifications": [ "Games", "WinForms", "Desktop", "Gondwana" ],
  "identity": "Gondwana.Templates.WinForms.CSharp",
  "name": "Gondwana WinForms Game",
  "shortName": "gondwana-winforms",
  "description": "A starter project for building a 2D Windows desktop game with the Gondwana Game Engine.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "icon": "icon.png",
  "sourceName": "MyGame",
  "preferNameDirectory": true,
  "symbols": {
    "Backbuffer": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "bitmap", "description": "CPU bitmap backbuffer (default, widest compatibility)" },
        { "choice": "gpu",    "description": "GPU-accelerated OpenGL backbuffer" }
      ],
      "defaultValue": "bitmap",
      "description": "The backbuffer type to use for rendering."
    },
    "UseGpuBackbuffer": {
      "type": "computed",
      "value": "(Backbuffer == \"gpu\")"
    }
  }
}
