<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0-browser</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Link SkiaSharp into the WASM runtime for dotnet run as well as publish. -->
		<WasmBuildNative>true</WasmBuildNative>
	</PropertyGroup>

	<ItemGroup>
		<!--
            Core Gondwana packages — track the latest 2.x releases.
            Run 'dotnet add package Gondwana' to update to a newer major version.
        -->
		<PackageReference Include="Gondwana" Version="2.*" />
		<PackageReference Include="Gondwana.Hosting" Version="2.*" />
		<PackageReference Include="Gondwana.Blazor" Version="2.*" />
		<PackageReference Include="Gondwana.Blazor.Hosting" Version="2.*" />
		<PackageReference Include="Gondwana.Audio.Browser" Version="2.*" />
        <PackageReference Include="Gondwana.Widgets" Version="2.*" />

		<!-- Blazor WebAssembly -->
		<!-- Keep the Blazor runtime and development server on the same published patch.
		     A floating 10.* range can select partially published Microsoft releases and break restore. -->
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
	</ItemGroup>

	<!--
        Static web content.
        gondwana-audio.js is the audio JS module used by Gondwana.Audio.Browser.
        All wwwroot/ files are served by the Blazor WebAssembly host.

        Gondwana.Audio.Browser registers gondwana-audio.js as a static web asset
        at the app-relative gondwana-audio.js URL. NuGet and project references
        both work without copying the file into the project's source wwwroot.
    -->

	<!--
        Add your asset files here so they are copied to the output directory.
        Example:
        <ItemGroup>
            <Content Include="assets\my-sprite.png">
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
    -->

</Project>
