<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>

        <!-- Template packages carry content only — no compiled output needed -->
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- NU5128: expected for template packages that have no lib output -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <!-- URLs / repository -->
        <PackageProjectUrl>https://github.com/Isthimius/Gondwana/tree/master/Tooling/Gondwana.Templates</PackageProjectUrl>

        <!-- NuGet packaging -->
        <IsPackable>true</IsPackable>
        <PackageId>Gondwana.Templates</PackageId>
        <PackageType>Template</PackageType>
        <Title>Gondwana Project Templates</Title>
        <Description>dotnet new templates for the Gondwana Game Engine. Scaffold ready-to-run WinForms, Avalonia, and Blazor WebAssembly games, including GPU-backed WebGL browser projects.</Description>
        <PackageTags>game-engine gamedev csharp dotnet template gondwana scaffold winforms avalonia blazor wasm webassembly webgl</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>gondwana-logo.png</PackageIcon>
		<PackageReleaseNotes>Full changelog: https://github.com/Isthimius/Gondwana/blob/master/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <!-- Exclude template source files from compilation — they are content only -->
        <Compile Remove="templates/**" />
    </ItemGroup>

	<ItemGroup>
		<!-- Pack all template files into content/ in the nupkg -->
		<Content Include="templates/**"
		 Exclude="
			templates/**/obj/**;
			templates/**/bin/**;
			templates/**/.vs/**;
			templates/**/*.user;
			templates/**/*.suo" />
	</ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
		<None Include="CHANGELOG.md" Pack="true" PackagePath="" />
        <None Include="..\..\gondwana-logo.png" Pack="true" PackagePath="" Link="gondwana-logo.png" />
    </ItemGroup>

</Project>
