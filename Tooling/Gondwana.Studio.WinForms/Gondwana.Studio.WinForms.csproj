<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Gondwana.Studio.WinForms</RootNamespace>
    <AssemblyName>Gondwana.Studio.WinForms</AssemblyName>
  </PropertyGroup>

  <!-- TODO: Add WeifenLuo.WinFormsUI.DockPanel 3.1.0 for full docking support -->
  <!-- Dark-themed docking (VS2015DarkTheme) mirrors Dock.Avalonia used in Gondwana.Studio -->
  <!-- <PackageReference Include="WeifenLuo.WinFormsUI.DockPanel" Version="3.1.0" /> -->

  <ItemGroup>
    <ProjectReference Include="..\Gondwana.Studio.Core\Gondwana.Studio.Core.csproj" />
  </ItemGroup>

</Project>
