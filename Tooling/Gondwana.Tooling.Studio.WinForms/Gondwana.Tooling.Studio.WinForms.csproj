<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Gondwana.Studio.WinForms</RootNamespace>
    <AssemblyName>Gondwana.Studio.WinForms</AssemblyName>
  </PropertyGroup>

  <!-- The outer shell uses the same DockPanelSuite dark theme as its hosted editors. -->
  <ItemGroup>
    <Compile Include="../Shared/WinForms/DockLayoutStore.cs" Link="Docking/DockLayoutStore.cs" />
    <Compile Include="../Shared/WinForms/DockLayoutPersistence.cs" Link="Docking/DockLayoutPersistence.cs" />
    <PackageReference Include="DockPanelSuite" Version="3.1.1" />
    <PackageReference Include="DockPanelSuite.ThemeVS2015" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gondwana.Tooling.Studio.WinForms.Tests" />
    <ProjectReference Include="..\Gondwana.Tooling.Studio.Core\Gondwana.Tooling.Studio.Core.csproj" />
    <ProjectReference Include="..\Gondwana.Tooling.Assets.WinForms\Gondwana.Tooling.Assets.WinForms.csproj" />
    <ProjectReference Include="..\Gondwana.Tooling.Tilesheets.WinForms\Gondwana.Tooling.Tilesheets.WinForms.csproj" />
    <ProjectReference Include="..\Gondwana.Tooling.Animations.WinForms\Gondwana.Tooling.Animations.WinForms.csproj" />
    <ProjectReference Include="..\Gondwana.Tooling.Audio.WinForms\Gondwana.Tooling.Audio.WinForms.csproj" />
    <ProjectReference Include="..\Gondwana.Tooling.Scenes.WinForms\Gondwana.Tooling.Scenes.WinForms.csproj" />
    <ProjectReference Include="..\Gondwana.Tooling.Sprites.WinForms\Gondwana.Tooling.Sprites.WinForms.csproj" />
  </ItemGroup>

</Project>
