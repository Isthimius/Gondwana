<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>Gondwana</RootNamespace>
		<AssemblyName>Gondwana</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

        <!-- URLs / repository -->
        <PackageProjectUrl>https://github.com/Isthimius/Gondwana</PackageProjectUrl>

        <!-- NuGet packaging -->
        <IsPackable>true</IsPackable>
		<PackageId>Gondwana</PackageId>
		<Title>Gondwana Game Engine</Title>
		<Description>2D and 2.5D C#/.NET game engine with tile maps, sprites, layered scenes, camera/view systems, and SkiaSharp rendering. Designed for tile-based worlds and practical engine architecture.</Description>
        <PackageTags>game-engine gamedev csharp dotnet 2d 2.5d tilemap tiles sprites skia skiaSharp engine</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>gondwana-logo.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.6" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.6" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.6" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.6" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.6" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
		<PackageReference Include="Svg.Skia" Version="4.6.0" />
		<PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.2" />
	</ItemGroup>

	<ItemGroup>
		<None Update="gondwana.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="..\gondwana-logo.png" Pack="true" PackagePath="" Link="gondwana-logo.png" />
	</ItemGroup>

</Project>
