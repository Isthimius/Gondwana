@startuml core-class-diagram
title Gondwana Core - Principal Types and Relationships
' Curated architectural class diagram, not an exhaustive API reference.
' Checked against master: 2026-11-10.
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package "Engine and state" {
  class Engine <<singleton>> {
    +{static} Instance : Engine
    +State : EngineState
    +Configuration : EngineConfiguration
    +Managers : EngineManagers
    +Input : EngineInputSystems
    +Initialize(...)
    +Start()
    +Start(uiContext)
    +StartTimerDriven(uiContext)
    +Tick()
    +Stop()
  }
  class EngineState {
    +AssetsFiles
    +Scenes
    +Sprites
    +SoundResources
    +Tilesheets
    +ValueBag : TypedValueBag
    +SaveToFile(path, ...)
    +{static} LoadFromFile(path, ...)
    +{static} MergeFromFile(path, ...)
  }
  class EngineConfiguration {
    +TargetFPS
    +VSync
    +MsaaSampleCount
    +RenderScale
    +RenderScalingFilter
    +TimerDrivenSimulationRate
    +StateFiles
  }
  class EngineManagers {
    +AudioResources
    +DirectDrawings
    +Sprites
    +Tilesheets
    +SvgResources
  }
  class EngineInputSystems {
    +KeyboardEventPoller
    +MouseEventPoller
    +GamepadEventPoller
    +TouchEventPoller
    +GamepadManager
  }
  class TypedValueBag
  interface IUiDispatcher
  interface IEngineDispatcher
  class UiDispatcher
  class EngineDispatcher
}

package "Rendering" {
  abstract class RenderSurfaceHostBase {
    +Backbuffer : BackbufferBase
    +Scene : Scene
    +ViewManager : ViewManager
    +Effects : EffectsManager
    +GlRenderAndSnapshot()
    +GlRenderToCanvas(destination)
  }
  class "RenderSurfaceHost<TBackbuffer>" as RenderSurfaceHost {
    +Bind(scene, limitCameraToWorldBoundPx)
    +RedrawDirtyRectangleOnly
    ~ProduceRenderFrameSnapshot(tick)
    ~RenderToBackbuffer(tick)
    ~PresentBackbufferToAdapter()
  }
  abstract class RenderSurfaceAdapterBase {
    +Width
    +Height
    +Presentation
    +Present(image, src, dest)
  }
  abstract class BackbufferBase {
    +Width
    +Height
    +Canvas
    +ClearColor
    +IsGlThreadRendered
    #RequestResize(width, height)
    #BeginFrame()
    #EndFrame()
    #Snapshot()
  }
  class BitmapBackbuffer
  class GpuBackbuffer {
    +VSync
    +MsaaSampleCount
    +EnsureInitialized(context)
    +Initialize(context, width, height)
    +RecordFrame()
  }
  class RecordingBackbuffer <<internal>>
  class RenderFrameMailbox <<internal>> {
    ~TryBeginBuild()
    ~Publish(slot, frame)
    ~TryAcquire()
    ~Release(slot)
  }
  class RenderFrameSnapshot <<internal>> {
    ~Width
    ~Height
    ~Replay(canvas)
  }
  class RenderSurfaceHostRegistry <<static>>
  class ViewManager {
    +Views
    +UpdateCameras(deltaSeconds)
  }
  class View {
    +Camera : Camera
    +Viewport : Viewport
    +ScreenPxToWorldPx(layer, point)
    +WorldPxToScreenPx(layer, point)
    +ScreenPxToGrid(layer, point)
  }
  class Camera {
    +PositionPx
    +PanTo(...)
    +Follow(...)
  }
  class Viewport {
    +TargetRectPx
    +Zoom
    +ScreenOffsetPx
  }
  class EffectsManager
}

package "Scene, drawing and animation" {
  class Scene {
    +SceneLayers
    +VisibleSceneLayers
    +FullRefreshNeeded
  }
  class SceneLayer {
    +Parallax
    +CoordinateSystem
    +ColliderRegistry
    +CollisionResolver
  }
  abstract class Tile {
    +CurrentFrame : Frame
    +TileAnimator : Animator
  }
  class SceneLayerTile
  class Sprite {
    +Movement : MovementController
    +TranslateWorldPx(dx, dy)
  }
  class SpriteManager
  class Frame <<struct>> {
    +Tilesheet
    +RegionName
    +XTile
    +YTile
    +Overhang : Spacing
    +TilePadding : Spacing
  }
  class Tilesheet {
    +Name
    +Regions
    +GetRegion(name)
    +GetFrame(regionName, x, y)
  }
  class TilesheetRegion {
    +Area
    +TileSize
    +TilePadding
    +RegionMargin
    +Overhang
  }
  class TilesheetRegistry
  class Animator {
    +CurrentCycle : Cycle
    +StartAnimation(...)
    +CycleAnimation(tick)
  }
  class Cycle {
    +CycleKey
    +Sequence : FrameSequence
    +ThrottleTime
  }
  class FrameSequence
  class MovementController
  class DirectDrawingManager {
    +UpdateAll(tick)
  }
  abstract class DirectDrawingBase {
    +Visible
    +ZOrder
    +Update(tick)
  }
  class DirectLightLayer
  class DirectDarknessOverlay
}

package "Collision model" {
  interface ICollisionEntity
  interface ICollisionMovableEntity
  interface IMovableOnSceneLayer
  interface ICollider
  class ColliderRegistry
  class CollisionResolver
}

Engine *-- EngineState
Engine *-- EngineManagers
Engine *-- EngineInputSystems
Engine --> EngineConfiguration
Engine --> RenderSurfaceHostRegistry
UiDispatcher ..|> IUiDispatcher
EngineDispatcher ..|> IEngineDispatcher

RenderSurfaceHostBase <|-- RenderSurfaceHost
RenderSurfaceHost *-- BackbufferBase
RenderSurfaceHost *-- ViewManager
RenderSurfaceHost --> RenderSurfaceAdapterBase
RenderSurfaceHost --> Scene
RenderSurfaceHostBase *-- EffectsManager
RenderSurfaceHostRegistry o-- RenderSurfaceHostBase
BackbufferBase <|-- BitmapBackbuffer
BackbufferBase <|-- GpuBackbuffer
BackbufferBase <|-- RecordingBackbuffer
RenderSurfaceHostBase --> RenderFrameMailbox : desktop GPU
RenderFrameMailbox o-- RenderFrameSnapshot
ViewManager *-- View
View *-- Camera
View *-- Viewport

Scene *-- SceneLayer
SceneLayer *-- SceneLayerTile
Tile <|-- SceneLayerTile
Tile <|-- Sprite
Tile *-- Animator
Tile --> Frame
Frame --> Tilesheet
Tilesheet *-- TilesheetRegion
TilesheetRegistry o-- Tilesheet
Animator --> Cycle
Cycle --> FrameSequence
Sprite *-- MovementController
SpriteManager o-- Sprite
DirectDrawingManager o-- DirectDrawingBase
DirectDrawingBase <|-- DirectLightLayer
DirectDrawingBase <|-- DirectDarknessOverlay
SceneLayer *-- ColliderRegistry
SceneLayer *-- CollisionResolver
Sprite ..|> IMovableOnSceneLayer
Sprite ..|> ICollisionMovableEntity
ICollisionMovableEntity --|> ICollisionEntity
ICollisionMovableEntity --|> IMovableOnSceneLayer
@enduml
