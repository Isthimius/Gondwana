@startuml rendering-pipeline-sequence
title Gondwana - Engine Frame and Rendering Sequence
' Desktop GPU snapshots and browser GPU paint are distinct code paths.
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "Engine\nRunSimulationCycle" as Engine
participant "Input / timers /\nsimulation" as Sim
participant "Effects and\nDirectDrawingManager" as Draw
participant "RenderSurfaceHost" as Host
participant "BitmapBackbuffer" as CPU
participant "Bitmap UI adapter" as CPUAdapter
participant "RenderFrameMailbox" as Mail
participant "RecordingBackbuffer" as Recorder
participant "Desktop GPU adapter\n(GL paint callback)" as GL
participant "GpuBackbuffer" as GPU

== Simulation cycle ==
Engine -> Sim : RefreshGamepads (hardware cadence)
Engine -> Sim : Plugin pre-cycle
Engine -> Sim : BeforeBackgroundTasksExecute
Engine -> Sim : PreCycle timers, input pollers
Engine -> Sim : Animations, movement, collisions, cameras
Engine -> Sim : AfterBackgroundTasksExecute

alt Foreground render due
  Engine -> Draw : Plugin pre-frame / BeforeFrameRender
  Engine -> Draw : Update Effects for each surface
  Engine -> Draw : DirectDrawingManager.UpdateAll(tick)
  loop Each desktop GPU surface
    Engine -> Host : ProduceRenderFrameSnapshot(tick)
    Host -> Mail : TryBeginBuild()
    alt Free slot
      Mail --> Host : build slot
      Host -> Recorder : Start / record full scene
      Recorder --> Host : immutable SKPicture commands
      Host -> Mail : Publish(slot, RenderFrameSnapshot)
      note right of Mail
        Retires an older published frame.
        Active rendering slot stays owned.
      end note
    else No free slot
      Mail --> Host : null (skip production)
    end
  end

  loop Each non-GL surface - bitmap render pass (all surfaces first)
    Engine -> Host : RenderToBackbuffer(tick)
    Host -> CPU : BeginFrame()
    Host -> CPU : Render dirty scene regions\n(or no-op / overlay-only)
  end
  loop Each non-GL surface - bitmap presentation pass (after all renders)
    Engine -> Host : PresentBackbufferToAdapter()
    Host -> CPU : EndFrame()
    Host -> CPU : Snapshot full / dirty rect as needed
    Host -> CPUAdapter : Present(image, source, destination)
    Host -> CPU : ClearDirtyRectangle / BeginFrame()
  end
  Engine -> GL : AfterFrameRender triggers repaint request
  Engine -> Sim : PostCycle timers
  Engine -> Sim : Plugin post-frame
end
Engine -> Sim : CPS / plugin post-cycle

== Desktop GPU GL paint (independent of engine cycle) ==
GL -> GPU : EnsureInitialized(current GRContext)
GL -> Host : GlRenderAndSnapshot()
Host -> Mail : TryAcquire()
alt Snapshot acquired and matching logical dimensions
  Mail --> Host : most recent published frame
  Host -> GPU : BeginFrame / Replay(SKPicture) / EndFrame
  Host -> GPU : Snapshot() -> SKImage
  Host -> Mail : Release(slot)
else No snapshot or stale dimensions
  Host -> GPU : Snapshot current frame
  opt Stale snapshot slot
    Host -> Mail : Release(slot)
  end
end
Host --> GL : GPU-backed image
GL -> GL : Draw image on GL framebuffer; dispose image
GL -> GPU : RecordFrame()

== Browser GPU path (no desktop snapshot mailbox) ==
participant "SKGLView paint callback" as Browser
Browser -> GPU : EnsureInitialized(current GRContext)
Browser -> Engine : Tick() (StartTimerDriven) inside paint callback
Browser -> Browser : ConsumeFrameRequest()
alt New scene frame due, or GPU backbuffer recreated
  Browser -> Host : GlRenderToCanvas(browserCanvas)
  Host -> GPU : Live scene render / EndFrame
  Host -> Browser : Draw current GPU surface into canvas
else Presentation without a new scene frame
  Browser -> Host : GlDrawCurrentFrameToCanvas(browserCanvas)
  Host -> Browser : Draw existing GPU surface into canvas
end
Browser -> GPU : RecordFrame() on successful presentation

note over Browser,Host
  Blazor bitmap instead uses host OnAnimationFrame()
  to drive Engine.Tick() from its own JS rAF loop.
  Browser GPU paint owns the simulation Tick and
  renders only when the backbuffer or frame is due.
end note
@enduml
