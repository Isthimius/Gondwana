@startuml architecture-diagram
' SVG output: docs/wiki/diagrams/architecture-diagram.svg (generated from this source).
' Rerender using the source-gated wiki diagram workflow.
title Gondwana Game Engine - Runtime Architecture
' Source: master, 2026-11-10. Logical architecture; not a literal call graph.
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam shadowing false
left to right direction

package "Application" {
  [Game logic / content] as Game
}

package "Platform hosting" {
  [GameHostBase] as HostBase
  [WinForms game hosts\n(bitmap and GPU)] as WinHosts
  [Avalonia game hosts\n(bitmap and GPU)] as AvHosts
  [Blazor game hosts\n(bitmap and GPU)] as WebHosts
}

package "Platform rendering and input adapters" {
  [WinForms adapters\nSKControl / SKGLControl] as WinAdapter
  [Avalonia adapters\nWriteableBitmap / OpenGL] as AvAdapter
  [Blazor adapters\ncanvas / SKGLView] as WebAdapter
}

package "Companion UI library" {
  [Gondwana.Widgets] as Widgets
}

package "Gondwana core" {
  [Engine singleton\nsimulation and frame cadence] as Engine
  [Input pollers / timers\nmovement / collisions] as Simulation
  [Scene / SceneLayer / Tile\nSprite / Animation] as Content
  [RenderSurfaceHost\nViewManager / Camera / Viewport] as Surface
  [BitmapBackbuffer\nCPU dirty rectangles] as CPU
  [GpuBackbuffer\nGPU full-surface rendering] as GPU
  [RenderFrameSnapshot\n3-slot RenderFrameMailbox\nDESKTOP GPU ONLY] as Mailbox
  [DirectDrawingManager\nEffectsManager] as Presentation
  [EngineState / definitions\nEngineConfiguration] as Persistence
}

Game --> HostBase : application lifecycle
WinHosts --|> HostBase
AvHosts --|> HostBase
WebHosts --|> HostBase
HostBase --> Engine : initialize / start / stop
WinHosts --> WinAdapter : bind
AvHosts --> AvAdapter : bind
WebHosts --> WebAdapter : bind

Engine --> Simulation : advance
Engine --> Content : update state
Engine --> Persistence : load / save / configure
Engine --> Presentation : foreground updates
Widgets --> Engine : depends on core
Engine --> Surface : foreground rendering
Surface --> Content : render bound scene
Surface --> CPU : bitmap path
Surface --> GPU : GPU path
Surface --> Mailbox : record desktop GPU commands

WinAdapter --> Surface : present / paint
AvAdapter --> Surface : present / paint
WebAdapter --> Surface : present / paint

note right of CPU
  CPU render and snapshot occur
  on the engine thread. The UI
  adapter presents the result.
end note
note right of Mailbox
  Engine publishes immutable commands.
  Desktop GL paint replays them.
  No live scene traversal is required
  in the desktop replay callback.
end note
note bottom of WebHosts
  Blazor drives Engine.Tick() from browser frames
  using StartTimerDriven(). Browser GPU painting
  renders synchronously: no desktop mailbox.
end note
@enduml
