@startuml component-diagram
title Gondwana - Project Components and Direct Dependencies
' ProjectReference edges, simplified to architectural dependencies.
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
left to right direction

package "Runtime libraries" {
  [Gondwana] as Core
  [Gondwana.Hosting] as Hosting
  [Gondwana.WinForms] as WinForms
  [Gondwana.Avalonia] as Avalonia
  [Gondwana.Blazor] as Blazor
  [Gondwana.Widgets] as Widgets
}
package "Host libraries" {
  [Gondwana.WinForms.Hosting] as WFHost
  [Gondwana.Avalonia.Hosting] as AvHost
  [Gondwana.Blazor.Hosting] as BlHost
}
package "Extensions" {
  [Gondwana.Audio.Browser] as AudioBrowser
  [Gondwana.Audio.NAudio] as AudioNAudio
  [Gondwana.Audio.Midi] as AudioMidi
  [Gondwana.Input.SDL2] as SDL2
  [Gondwana.Video] as Video
  [Gondwana.Video.Widgets] as VideoWidgets
}
package "Tooling / authoring" {
  [Gondwana.Cli] as CLI
  [Gondwana.Templates] as Templates
  [Gondwana.Tooling.Studio.WinForms] as Studio
  [Standalone editors\nGTS / GANI / GSCN / GSPR / GSND / GAF] as Editors
  [Gondwana.Tooling.Importers] as Importers
  [Gondwana.Mcp] as MCP
}

Hosting --> Core
WinForms --> Core
Avalonia --> Core
Blazor --> Core
Blazor --> Widgets
Widgets --> Core
WFHost --> Hosting
WFHost --> WinForms
AvHost --> Hosting
AvHost --> Avalonia
BlHost --> Hosting
BlHost --> Blazor

AudioBrowser --> Core
AudioNAudio --> Core
AudioMidi --> AudioNAudio
SDL2 --> Core
Video --> Core
VideoWidgets --> Video
VideoWidgets --> Widgets

CLI ..> Templates : scaffolds / manages
Studio ..> Editors : shared tooling
Studio ..> Importers : imports
MCP ..> Core : engine guidance / tooling

note right of Studio
  Tooling links are conceptual workflows,
  not necessarily project references.
  Runtime and host arrows above are
  dependencies on other Gondwana projects.
end note
@enduml
