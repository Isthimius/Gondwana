<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/DockPreferenceIsolation.cs" Link="DockPreferenceIsolation.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../Tooling/Gondwana.Tooling.Studio.WinForms/Gondwana.Tooling.Studio.WinForms.csproj" />
    <ProjectReference Include="../../Tooling/Gondwana.Tooling.Studio.Plugin.ProjectDiagnostics/Gondwana.Tooling.Studio.Plugin.ProjectDiagnostics.csproj" />
    <ProjectReference Include="../../Tooling/Gondwana.Tooling.Studio.Plugin.ExternalImport/Gondwana.Tooling.Studio.Plugin.ExternalImport.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <Target Name="DeployPluginForIntegrationTests" AfterTargets="Build">
    <ItemGroup>
      <DiagnosticsPlugin Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Gondwana.Tooling.Studio.Plugin.ProjectDiagnostics' and '%(Extension)' == '.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(DiagnosticsPlugin)" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)Gondwana.Tooling.Studio.Plugin.ExternalImport.dll;$(TargetDir)Gondwana.Tooling.Importers.dll" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../Tooling/Gondwana.Tooling.Studio.Plugin.ExternalImport/bin/$(Configuration)/net8.0-windows/Gondwana.Tooling.Studio.Plugin.ExternalImport.deps.json" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
