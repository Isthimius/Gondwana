<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../Gondwana.Tooling.Importers.Tests/Fixtures/Godot4/*" Link="Fixtures/Godot4/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/DockPreferenceIsolation.cs" Link="DockPreferenceIsolation.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../Tooling/Gondwana.Tooling.Studio.WinForms/Gondwana.Tooling.Studio.WinForms.csproj" Aliases="global,studio" />
    <ProjectReference Include="../../Tooling/Gondwana.Tooling.Studio.Plugin.ProjectDiagnostics/Gondwana.Tooling.Studio.Plugin.ProjectDiagnostics.csproj" />
    <ProjectReference Include="../../Tooling/Gondwana.Tooling.Studio.Plugin.ExternalImport/Gondwana.Tooling.Studio.Plugin.ExternalImport.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <Target Name="DeployPluginForIntegrationTests" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)Gondwana.Tooling.Studio.Plugin.ProjectDiagnostics.dll;../../Tooling/Gondwana.Tooling.Studio.Plugin.ProjectDiagnostics/plugin.json" DestinationFolder="$(TargetDir)plugins/ProjectDiagnostics" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)Gondwana.Tooling.Studio.Plugin.ExternalImport.dll;$(TargetDir)Gondwana.Tooling.Importers.dll;../../Tooling/Gondwana.Tooling.Studio.Plugin.ExternalImport/plugin.json" DestinationFolder="$(TargetDir)plugins/ExternalImport" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../Tooling/Gondwana.Tooling.Studio.Plugin.ExternalImport/bin/$(Configuration)/net8.0-windows/Gondwana.Tooling.Studio.Plugin.ExternalImport.deps.json" DestinationFolder="$(TargetDir)plugins/ExternalImport" SkipUnchangedFiles="true" />
    <Delete Files="$(TargetDir)plugins/Gondwana.Tooling.Studio.Plugin.ProjectDiagnostics.dll;$(TargetDir)plugins/Gondwana.Tooling.Studio.Plugin.ExternalImport.dll;$(TargetDir)plugins/Gondwana.Tooling.Studio.Plugin.ExternalImport.deps.json;$(TargetDir)plugins/Gondwana.Tooling.Importers.dll" />
  </Target>
</Project>
