<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-browser</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- URLs / repository -->
        <PackageProjectUrl>https://github.com/Isthimius/Gondwana/tree/master/Gondwana.Audio.Browser</PackageProjectUrl>

        <!-- NuGet packaging -->
        <IsPackable>true</IsPackable>
        <PackageId>Gondwana.Audio.Browser</PackageId>
        <Title>Gondwana Audio Browser (WASM) Support</Title>
        <Description>Browser/WASM audio playback support for the Gondwana Game Engine, providing HTML5 Audio API integration via JavaScript interop for web-deployed games.</Description>
        <PackageTags>game-engine gamedev csharp dotnet audio browser wasm webassembly html5 avalonia js-interop</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>gondwana-logo.png</PackageIcon>
        <!--
            contentFiles: the JS module is copied into the consuming project's wwwroot/ folder
            so that dotnet publish bundles it into AppBundle/.
        -->
        <ContentTargetFolders>content</ContentTargetFolders>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Gondwana\Gondwana.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            gondwana-audio.js is shipped as a NuGet content file so that consumers
            automatically get it copied into their wwwroot/ directory.
        -->
        <Content Include="wwwroot/gondwana-audio.js">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/any/wwwroot/</PackagePath>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
        <None Include="..\gondwana-logo.png" Pack="true" PackagePath="" Link="gondwana-logo.png" />
    </ItemGroup>

</Project>
