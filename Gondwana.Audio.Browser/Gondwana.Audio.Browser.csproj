<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-browser</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- URLs / repository -->
        <PackageProjectUrl>https://github.com/Isthimius/Gondwana/tree/master/Gondwana.Audio.Browser</PackageProjectUrl>

        <!-- NuGet packaging -->
        <IsPackable>true</IsPackable>
        <PackageId>Gondwana.Audio.Browser</PackageId>
        <Title>Gondwana Audio Browser (WASM) Support</Title>
        <Description>Browser/WASM audio playback support for the Gondwana Game Engine, providing HTML5 Audio API integration via JavaScript interop for web-deployed games.</Description>
        <PackageTags>game-engine gamedev csharp dotnet audio browser wasm webassembly html5 avalonia js-interop</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>gondwana-logo.png</PackageIcon>
		<PackageReleaseNotes>Full changelog: https://github.com/Isthimius/Gondwana/blob/master/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Gondwana\Gondwana.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
		<None Include="CHANGELOG.md" Pack="true" PackagePath="" />
        <None Include="..\gondwana-logo.png" Pack="true" PackagePath="" Link="gondwana-logo.png" />
        
        <!-- For NuGet: include JS as content -->
        <None Include="wwwroot\gondwana-audio.js" Pack="true" PackagePath="contentFiles\any\any\wwwroot\" />
    </ItemGroup>

</Project>
