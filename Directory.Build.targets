<Project>
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <!-- Symbols / Source Link -->
        <IncludeSymbols Condition="'$(PackageType)' != 'Template'">true</IncludeSymbols>
        <SymbolPackageFormat Condition="'$(PackageType)' != 'Template'">snupkg</SymbolPackageFormat>

        <!-- NuGet packaging -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

        <!-- Repository -->
        <RepositoryUrl>https://github.com/Isthimius/Gondwana</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <!-- Set the application icon for WinForms tooling executables. -->
    <PropertyGroup
        Condition="'$(UseWindowsForms)' == 'true'
      and '$(OutputType)' == 'WinExe'
      and $(MSBuildProjectName.StartsWith('Gondwana.Tooling.'))">
        <ApplicationIcon>$(MSBuildThisFileDirectory)assets/gondwana-logo.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Preserve the icon resource in each executable for compatibility. -->
    <ItemGroup
        Condition="'$(UseWindowsForms)' == 'true'
      and '$(OutputType)' == 'WinExe'
      and $(MSBuildProjectName.StartsWith('Gondwana.Tooling.'))">
        <EmbeddedResource Include="$(MSBuildThisFileDirectory)assets/gondwana-logo.ico"
                          LogicalName="Gondwana.Tooling.BrandingIcon" />
    </ItemGroup>
</Project>
