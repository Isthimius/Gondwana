<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net8.0-browser</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Gondwana.Demos.Spot</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.*" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.*" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Spot.Shared\Host\*.cs" Link="Host\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spot.Shared\Spot.Shared.csproj" />
        <ProjectReference Include="..\..\Gondwana.Widgets\Gondwana.Widgets.csproj" />
        <ProjectReference Include="..\..\Gondwana\Gondwana.csproj" />
        <ProjectReference Include="..\..\Gondwana.Hosting\Gondwana.Hosting.csproj" />
        <ProjectReference Include="..\..\Gondwana.Blazor\Gondwana.Blazor.csproj" />
        <ProjectReference Include="..\..\Gondwana.Blazor.Hosting\Gondwana.Blazor.Hosting.csproj" />
        <ProjectReference Include="..\..\Gondwana.Audio.Browser\Gondwana.Audio.Browser.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <SpotAssetSourceRoot>$(MSBuildProjectDirectory)\..\Spot\assets</SpotAssetSourceRoot>
        <SpotGafPath>$(MSBuildProjectDirectory)\wwwroot\assets\spot.gaf</SpotGafPath>
    </PropertyGroup>

    <ItemGroup>
        <SpotAssetSource Include="$(SpotAssetSourceRoot)\*.*" />
        <Content Remove="wwwroot\assets\spot.gaf" />
        <Content Include="wwwroot\assets\spot.gaf" />
        <Content Include="..\Spot\assets\spot_ico.png" Link="wwwroot\assets\spot_ico.png" />
    </ItemGroup>

    <UsingTask TaskName="PackSpotGaf"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <SourceRoot ParameterType="System.String" Required="true" />
            <OutputPath ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Reference Include="System.IO.Compression" />
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.IO.Compression" />
            <Using Namespace="System.Linq" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                Directory.CreateDirectory(Path.GetDirectoryName(OutputPath)!);

                if (File.Exists(OutputPath))
                    File.Delete(OutputPath);

                using var output = File.Create(OutputPath);
                using var archive = new ZipArchive(output, ZipArchiveMode.Create, leaveOpen: false);

                foreach (var file in Directory.GetFiles(SourceRoot, "*", SearchOption.TopDirectoryOnly)
                                              .OrderBy(path => path, StringComparer.OrdinalIgnoreCase))
                {
                    var extension = Path.GetExtension(file).ToLowerInvariant();
                    var assetType = extension switch
                    {
                        ".png" or ".jpg" or ".jpeg" or ".bmp" or ".gif" or ".ico" => "Image",
                        ".mp3" or ".wav" or ".ogg" or ".flac" or ".m4a" or ".aac" or ".opus" or ".webm" => "Audio",
                        ".ttf" or ".otf" => "Font",
                        ".gts" => "TilesheetDefinition",
                        _ => "Misc"
                    };

                    var assetName = Path.GetFileName(file).ToLowerInvariant();
                    var entry = archive.CreateEntry(
                        $"{assetType}_{assetName}",
                        CompressionLevel.Optimal);
                    entry.LastWriteTime = new DateTimeOffset(2000, 1, 1, 0, 0, 0, TimeSpan.Zero);

                    using var source = File.OpenRead(file);
                    using var destination = entry.Open();
                    source.CopyTo(destination);
                }
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="GenerateSpotGaf"
            BeforeTargets="PrepareForBuild"
            Inputs="@(SpotAssetSource)"
            Outputs="$(SpotGafPath)">
        <PackSpotGaf SourceRoot="$(SpotAssetSourceRoot)" OutputPath="$(SpotGafPath)" />
    </Target>

    <Target Name="CopyAudioJS" BeforeTargets="Build">
        <Copy SourceFiles="..\..\Gondwana.Audio.Browser\wwwroot\gondwana-audio.js" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\" SkipUnchangedFiles="true" />
    </Target>

</Project>
