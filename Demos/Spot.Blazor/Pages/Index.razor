@page "/"
@using Gondwana
@using Gondwana.Assets
@using Gondwana.Blazor
@using Gondwana.Blazor.Configuration
@using Gondwana.Blazor.Rendering
@using Gondwana.Widgets.Dialogs
@using Gondwana.Widgets.Menus
@using Microsoft.Extensions.Logging
@inject HttpClient Http
@inject IJSRuntime JS
@inject ILogger<Index> Logger
@implements IDisposable

<PageTitle>Spot!</PageTitle>

<div class="page-shell">
    <div class="game-wrapper">
        <BlazorGpuRenderSurfaceComponent @ref="_renderSurface" style="position:absolute; inset:0;" />

        @if (_loading)
        {
            <div class="startup-loader startup-loader-overlay">
                <div class="startup-card">
                    <img class="startup-logo" src="assets/spot_ico.png" alt="" />
                    <h1 class="startup-title">SPOT!</h1>
                    <div class="startup-message">Preparing the game...</div>
                    <div class="startup-progress" aria-hidden="true">
                        <div class="startup-progress-fill indeterminate"></div>
                    </div>
                    <div class="startup-percent">Loading game assets</div>
                    <div class="startup-powered">Powered by Gondwana</div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="status-overlay error">@_errorMessage</div>
        }
    </div>
</div>

@code {
    private const int GpuTargetFps = 0;
    private const int GpuMsaaSampleCount = 4;
    private const string ConfigurationKey = "spot.configuration";

    private BlazorGpuRenderSurfaceComponent? _renderSurface;
    private SpotGameHost? _gameHost;
    private MenuBarWidget? _menuBar;
    private HowToPlayDialog? _howToPlayDialog;
    private AboutBox? _aboutBox;
    private global::SkiaSharp.SKImage? _aboutSpotLogo;
    private global::SkiaSharp.SKImage? _aboutGondwanaLogo;
    private global::SkiaSharp.SKTypeface? _aboutTypeface;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _renderSurface is null)
            return;

        AssetsFile? assets = null;
        BrowserLocalStorageEngineConfigurationStore? configurationStore = null;

        try
        {
            var packageBytes = await Http.GetByteArrayAsync("assets/spot.gaf");
            using var packageStream = new MemoryStream(packageBytes, writable: false);
            assets = AssetsFile.Load(packageStream);

            _gameHost = new SpotGameHost(_renderSurface, JS, assets);
            assets = null; // Ownership transferred to the host.

            _gameHost.Engine.InitializationComplete += ConfigureEngine;

            configurationStore = new BrowserLocalStorageEngineConfigurationStore(
                JS,
                ConfigurationKey,
                autoSave: true);

            _gameHost.InitializeWithConfigurationStore(
                configurationStore,
                logLevel: LogLevel.Warning);
            configurationStore = null; // Engine owns the initialized store.

            _loading = false;
            StateHasChanged();

            _gameHost.CreateSplash(
                _renderSurface.Host,
                () =>
                {
                    _gameHost.BeginPostSplashStartup();
                    ApplyLoadedSettings();
                    CreateMenu();
                });
        }
        catch (Exception ex)
        {
            if (_gameHost is not null)
            {
                _gameHost.Engine.InitializationComplete -= ConfigureEngine;

                try
                {
                    _gameHost.Dispose();
                }
                catch (Exception disposeException)
                {
                    Logger.LogWarning(disposeException, "Failed to clean up Spot.Blazor after initialization failure");
                }

                _gameHost = null;
            }

            configurationStore?.Dispose();
            assets?.Dispose();
            _loading = false;
            _errorMessage = $"Failed to initialize Spot!: {ex.Message}";
            Logger.LogError(ex, "Failed to initialize Spot.Blazor");
            StateHasChanged();
        }
    }

    private void ConfigureEngine()
    {
        if (_gameHost is null)
            return;

        _gameHost.Engine.Configuration.TargetFPS = GpuTargetFps;
        _gameHost.Engine.Configuration.VSync = false;
        _gameHost.Engine.Configuration.MsaaSampleCount = GpuMsaaSampleCount;
    }

    private void ApplyLoadedSettings()
    {
        if (_gameHost is null)
            return;

        bool music = ReadBoolSetting(SpotSettings.Music);
        bool soundEffects = ReadBoolSetting(SpotSettings.SoundEffects);
        bool jiggle = ReadBoolSetting(SpotSettings.Jiggle);
        bool clouds = ReadBoolSetting(SpotSettings.Clouds);

        _gameHost.Engine.EngineDispatcher.Post(() =>
        {
            _gameHost.SetMusicEnabled(music);
            _gameHost.SetSoundEffectsEnabled(soundEffects);
            _gameHost.SetJiggleEnabled(jiggle);
            _gameHost.SetCloudsEnabled(clouds);
        });
    }

    private bool ReadBoolSetting(string key)
    {
        return _gameHost is not null
            ? SpotSettings.ReadBool(_gameHost.Engine.Configuration, key, defaultValue: true)
            : true;
    }

    private void PersistSetting(string key, bool value)
    {
        if (_gameHost is null)
            return;

        SpotSettings.WriteBool(_gameHost.Engine, key, value);
    }

    private void CreateMenu()
    {
        if (_menuBar is not null || _gameHost is null || _renderSurface is null)
            return;

        var view = _renderSurface.Host.ViewManager.Views[0];
        var state = new SpotMenuState(
            ReadBoolSetting(SpotSettings.Music),
            ReadBoolSetting(SpotSettings.SoundEffects),
            ReadBoolSetting(SpotSettings.Jiggle),
            ReadBoolSetting(SpotSettings.Clouds));

        _menuBar = SpotMenuFactory.Create(
            _renderSurface.Host,
            view,
            state,
            new SpotMenuActions
            {
                NewGame = () => _gameHost.OpenNewGameDialog(_gameHost.LastNewGameOptions),
                MusicChanged = SetMusicEnabled,
                SoundEffectsChanged = SetSoundEffectsEnabled,
                JiggleChanged = SetJiggleEnabled,
                CloudsChanged = SetCloudsEnabled,
                HowToPlay = OpenHowToPlayDialog,
                About = OpenAboutBox,
                Exit = null
            });

        StartMonitoringMenuKeys();
    }

    private void StartMonitoringMenuKeys()
    {
        var keyboard = _gameHost?.Engine.Input.KeyboardEventPoller;
        if (keyboard is null)
            return;

        const double repeatIntervalSec = 0.10;

        for (int key = 'A'; key <= 'Z'; key++)
            keyboard.StartMonitoringKey(key, timeBetweenEvents: repeatIntervalSec);

        for (int key = '0'; key <= '9'; key++)
            keyboard.StartMonitoringKey(key, timeBetweenEvents: repeatIntervalSec);

        for (int key = 96; key <= 111; key++)
            keyboard.StartMonitoringKey(key, timeBetweenEvents: repeatIntervalSec);

        foreach (int key in new[]
                 {
                     8, 13, 27, 32, 33, 34, 35, 36, 37, 38, 39, 40, 46,
                     186, 187, 188, 189, 190, 191, 192, 219, 220, 221, 222
                 })
        {
            keyboard.StartMonitoringKey(key, timeBetweenEvents: repeatIntervalSec);
        }
    }

    private void SetMusicEnabled(bool enabled)
    {
        if (_gameHost is null)
            return;

        PersistSetting(SpotSettings.Music, enabled);
        _gameHost.Engine.EngineDispatcher.Post(() => _gameHost.SetMusicEnabled(enabled));
    }

    private void SetSoundEffectsEnabled(bool enabled)
    {
        if (_gameHost is null)
            return;

        PersistSetting(SpotSettings.SoundEffects, enabled);
        _gameHost.Engine.EngineDispatcher.Post(() => _gameHost.SetSoundEffectsEnabled(enabled));
    }

    private void SetJiggleEnabled(bool enabled)
    {
        if (_gameHost is null)
            return;

        PersistSetting(SpotSettings.Jiggle, enabled);
        _gameHost.Engine.EngineDispatcher.Post(() => _gameHost.SetJiggleEnabled(enabled));
    }

    private void SetCloudsEnabled(bool enabled)
    {
        if (_gameHost is null)
            return;

        PersistSetting(SpotSettings.Clouds, enabled);
        _gameHost.Engine.EngineDispatcher.Post(() => _gameHost.SetCloudsEnabled(enabled));
    }

    private void OpenHowToPlayDialog()
    {
        if (_howToPlayDialog is not null)
        {
            _howToPlayDialog.Activate();
            return;
        }

        if (_renderSurface is null)
            return;

        var dialog = new HowToPlayDialog(
            _renderSurface.Host,
            _renderSurface.Host.ViewManager.Views[0]);

        _howToPlayDialog = dialog;
        dialog.Closed += _ => _howToPlayDialog = null;
        dialog.Show();
        dialog.Activate();
    }

    private void OpenAboutBox()
    {
        if (_aboutBox is not null)
        {
            _aboutBox.Activate();
            return;
        }

        if (_gameHost is null || _renderSurface is null)
            return;

        EnsureAboutResources();

        var about = SpotAboutBoxFactory.Create(
            _renderSurface.Host,
            _renderSurface.Host.ViewManager.Views[0],
            _aboutSpotLogo!,
            _aboutGondwanaLogo!,
            _aboutTypeface!,
            new BlazorExternalUriLauncher(JS));

        _aboutBox = about;
        about.Closed += _ => _aboutBox = null;
        about.Show();
        about.Activate();
    }

    private void EnsureAboutResources()
    {
        if (_gameHost is null)
            return;

        if (_aboutSpotLogo is null)
        {
            using var stream = _gameHost.OpenAsset(AssetTypes.Image, "spot.png");
            _aboutSpotLogo = global::SkiaSharp.SKImage.FromEncodedData(stream)
                ?? throw new InvalidOperationException("Failed to decode Spot About-box image.");
        }

        if (_aboutGondwanaLogo is null)
        {
            using var stream = _gameHost.OpenAsset(AssetTypes.Image, "gondwana-logo-text.png");
            _aboutGondwanaLogo = global::SkiaSharp.SKImage.FromEncodedData(stream)
                ?? throw new InvalidOperationException("Failed to decode Gondwana About-box image.");
        }

        if (_aboutTypeface is null)
        {
            using var stream = _gameHost.OpenAsset(AssetTypes.Font, "ArchitectsDaughter-Regular.ttf");
            _aboutTypeface = global::SkiaSharp.SKTypeface.FromStream(stream)
                ?? throw new InvalidOperationException("Failed to decode Spot About-box font.");
        }
    }

    public void Dispose()
    {
        _howToPlayDialog?.Dispose();
        _howToPlayDialog = null;

        _aboutBox?.Dispose();
        _aboutBox = null;

        _aboutSpotLogo?.Dispose();
        _aboutSpotLogo = null;

        _aboutGondwanaLogo?.Dispose();
        _aboutGondwanaLogo = null;

        _aboutTypeface?.Dispose();
        _aboutTypeface = null;

        _menuBar?.Dispose();
        _menuBar = null;

        if (_gameHost is not null)
        {
            _gameHost.Engine.InitializationComplete -= ConfigureEngine;
            _gameHost.Dispose();
            _gameHost = null;
        }
    }
}
