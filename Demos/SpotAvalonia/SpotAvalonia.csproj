<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks Condition="'$(GITHUB_ACTIONS)' == 'true'">net8.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(GITHUB_ACTIONS)' != 'true'">net8.0;net8.0-browser</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>Gondwana.Demos.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- Define BROWSER constant when building for the browser target -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-browser'">
        <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <BrowserProjectFolder>./</BrowserProjectFolder>
        <UseAppHost>false</UseAppHost>
    </PropertyGroup>

    <ItemGroup>
        <!-- Assets linked from the Spot demo to avoid duplication -->
        <Content Include="../Spot/assets/ArchitectsDaughter-Regular.ttf" Link="assets/ArchitectsDaughter-Regular.ttf">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\clouds.png" Link="assets\clouds.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\freesound_community-080047_lose_funny_retro_video-game-80925.mp3" Link="assets\freesound_community-080047_lose_funny_retro_video-game-80925.mp3">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\freesound_community-bump-7-92964.mp3" Link="assets\freesound_community-bump-7-92964.mp3">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\freesound_community-velcro_fast-91558.mp3" Link="assets\freesound_community-velcro_fast-91558.mp3">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\freesound_community-water-drip-45622.mp3" Link="assets\freesound_community-water-drip-45622.mp3">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\peekaboolabcreative-11l-victory_sound_with_t-1749487402950-357606.mp3" Link="assets\peekaboolabcreative-11l-victory_sound_with_t-1749487402950-357606.mp3">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\sounovamusic-puzzle-amp-casual-game-music-460543.mp3" Link="assets\sounovamusic-puzzle-amp-casual-game-music-460543.mp3">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\sources.txt" Link="assets\sources.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\spot.png" Link="assets\spot.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\spot_ico.png" Link="assets\spot_ico.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\gondwana-logo-text.png" Link="assets\gondwana-logo-text.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\rohhsadotcom-knock-on-wood-02-421991.mp3" Link="assets\rohhsadotcom-knock-on-wood-02-421991.mp3">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\universfield-bubble-pop-293342.mp3" Link="assets\universfield-bubble-pop-293342.mp3">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\OFL.txt" Link="assets\OFL.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <!-- Bubble sprites (archived versions used by SpotAvalonia's individual-color sprite approach) -->
        <Content Include="..\Spot\assets\archive\bubble-blue.png" Link="assets\bubble-blue.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-green.png" Link="assets\bubble-green.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-pink.png" Link="assets\bubble-pink.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-red.png" Link="assets\bubble-red.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-yellow.png" Link="assets\bubble-yellow.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-blue-happy.png" Link="assets\bubble-blue-happy.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-green-happy.png" Link="assets\bubble-green-happy.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-pink-happy.png" Link="assets\bubble-pink-happy.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-red-happy.png" Link="assets\bubble-red-happy.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="..\Spot\assets\archive\bubble-yellow-happy.png" Link="assets\bubble-yellow-happy.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Desktop-only packages -->
    <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-browser'">
        <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    </ItemGroup>

    <!-- Browser-only packages -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-browser'">
        <PackageReference Include="Avalonia.Browser" Version="11.3.13" />
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.2" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.1.1" />
        <ProjectReference Include="..\..\Gondwana.Audio.Browser\Gondwana.Audio.Browser.csproj" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
      <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    </ItemGroup>

    <!--
        gondwana-audio.js is provided by the Gondwana.Audio.Browser project reference.
        The Avalonia Browser SDK strips the wwwroot/ prefix when publishing content items,
        so the file ends up at the publish root and is reachable as ./gondwana-audio.js.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\Gondwana.Hosting\Gondwana.Hosting.csproj" />
        <ProjectReference Include="..\..\Gondwana.Avalonia\Gondwana.Avalonia.csproj" />
        <ProjectReference Include="..\..\Gondwana.Avalonia.Hosting\Gondwana.Avalonia.Hosting.csproj" />
        <ProjectReference Include="..\..\Gondwana\Gondwana.csproj" />
    </ItemGroup>

</Project>
