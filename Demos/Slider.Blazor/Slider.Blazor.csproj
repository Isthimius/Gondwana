<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative>
    <RootNamespace>Gondwana.Demos.Slider</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Slider.Shared/Slider.Shared.csproj" />
    <ProjectReference Include="../../Gondwana/Gondwana.csproj" />
    <ProjectReference Include="../../Gondwana.Widgets/Gondwana.Widgets.csproj" />
    <ProjectReference Include="../../Gondwana.Blazor/Gondwana.Blazor.csproj" />
    <ProjectReference Include="../../Gondwana.Blazor.Hosting/Gondwana.Blazor.Hosting.csproj" />
    <ProjectReference Include="../../Gondwana.Audio.Browser/Gondwana.Audio.Browser.csproj" />
  </ItemGroup>
  <!-- Keep the source assets shared with Spot/Slider.WinForms; don't duplicate them in git. -->
  <ItemGroup>
    <!-- A physical web-root file is required for the standalone WASM dev server
         to serve the PNG rather than falling back to index.html. -->
    <Content Remove="wwwroot/assets/gondwana-logo-text.png" />
    <Content Include="wwwroot/assets/gondwana-logo-text.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- Mirror Spot.Blazor: serve a real generated .gaf rather than linked
         individual WAV paths (which can resolve to the SPA HTML fallback). -->
    <Content Remove="wwwroot/assets/slider.gaf" />
    <Content Include="wwwroot/assets/slider.gaf" />
  </ItemGroup>

  <!-- Like Spot's GenerateSpotGaf, stage the web asset before the SDK resolves
       static web assets. The source remains the canonical Spot.Shared PNG. -->
  <Target Name="StageSliderAboutLogo" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot/assets" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../Spot.Shared/assets/gondwana-logo-text.png"
          DestinationFiles="$(MSBuildProjectDirectory)/wwwroot/assets/gondwana-logo-text.png"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Reuse Spot's proven GAF packer with Slider's own canonical sound assets.
       The pack is generated into the physical web root before static asset discovery. -->
  <PropertyGroup>
    <SpotBrowserAssets>true</SpotBrowserAssets>
    <SpotAssetSourceRoot>$(MSBuildProjectDirectory)/../Slider.WinForms/assets</SpotAssetSourceRoot>
    <SpotGafPath>$(MSBuildProjectDirectory)/wwwroot/assets/slider.gaf</SpotGafPath>
  </PropertyGroup>
  <Import Project="../Spot.Shared/Spot.Assets.targets" />
</Project>
