@page "/"
@page "/index.html"
@using System.Drawing
@using System.Text.Json
@using Gondwana.Assets
@using Gondwana.Blazor.Rendering
@using Microsoft.Extensions.Logging
@inject HttpClient Http
@inject IJSRuntime JS
@inject ILogger<Index> Logger
@implements IAsyncDisposable

<PageTitle>Gondwana: Slider</PageTitle>

<div class="game-shell">
    <div class="game-board" @ref="_container">
        <BlazorGpuRenderSurfaceComponent @ref="_surface" style="position:absolute;inset:0;" />

        @if (_loading)
        {
            <div class="startup-overlay" role="status">Preparing Slider...</div>
        }

        @if (_picker != PickerMode.None)
        {
            <div class="dialog-backdrop">
                <div class="browser-dialog" role="dialog" aria-modal="true" aria-labelledby="slider-picker-title">
                    @if (_picker == PickerMode.Picture)
                    {
                        <h2 id="slider-picker-title">Open picture</h2>
                        <p>Select an image on this device (up to 16 MiB).</p>
                        <InputFile OnChange="OnPictureSelected" accept="image/png,image/jpeg,image/webp,image/gif,image/bmp" />
                    }
                    else
                    {
                        <h2 id="slider-picker-title">Load puzzle</h2>
                        <p>Select a Slider .slider.json save file (up to 64 MiB).</p>
                        <InputFile OnChange="OnGameSelected" accept=".slider.json,.json,application/json" />
                    }
                    <button @onclick="ClosePicker">Cancel</button>
                </div>
            </div>
        }

        @if (_notice is not null)
        {
            <div class="notice" role="alert">
                <span>@_notice</span>
                <button @onclick="() => _notice = null">Dismiss</button>
            </div>
        }
    </div>
</div>

@code {
    private const long MaxImageBytes = 16L * 1024 * 1024;
    private const long MaxSaveBytes = 64L * 1024 * 1024;
    private const int MinLogicalWidth = 1200;
    private const int MinLogicalHeight = 780;

    private enum PickerMode { None, Picture, SavedGame }

    private ElementReference _container;
    private BlazorGpuRenderSurfaceComponent? _surface;
    private SliderBlazorGameHost? _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Index>? _dotNetRef;
    private PickerMode _picker;
    private int _pictureColumns = 4;
    private int _pictureRows = 3;
    private bool _disposed;
    private bool _loading = true;
    private string? _notice;
    private bool _focusPickerPending;
    private bool _restoreCanvasFocusPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_module is null || _disposed)
                return;

            if (_focusPickerPending && _picker != PickerMode.None && _dotNetRef is not null)
            {
                _focusPickerPending = false;
                await _module.InvokeVoidAsync("focusDialog", _container, _dotNetRef);
            }
            else if (_restoreCanvasFocusPending && _picker == PickerMode.None)
            {
                _restoreCanvasFocusPending = false;
                await _module.InvokeVoidAsync("restoreCanvasFocus", _container);
            }

            return;
        }

        if (_surface is null)
            return;

        AssetsFile? assets = null;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./slider-browser.js");
            string? stored = await _module.InvokeAsync<string?>("readScores");
            IReadOnlyList<SliderScore> scores = ReadStoredScores(stored);

            // Fail fast on an invalid asset response, rather than sending HTML
            // fallback bytes to the browser audio backend as a supposed WAV.
            byte[] packageBytes = await Http.GetByteArrayAsync("assets/slider.gaf");
            using var packageStream = new MemoryStream(packageBytes, writable: false);
            assets = AssetsFile.Load(packageStream);
            byte[] logoData = await Http.GetByteArrayAsync("assets/gondwana-logo-text.png");

            if (_disposed)
                return;

            // Never decode an image inside the engine's synchronous menu callback.
            // The About dialog receives a cached image, prepared after engine startup.
            global::SkiaSharp.SKImage? aboutLogo = null;
            var store = new SliderBrowserScoreStore(scores, SaveScoresInBrowser);

            _host = new SliderBlazorGameHost(_surface, JS, store, () => aboutLogo, assets);
            assets = null; // Ownership transferred to host.
            _host.OpenPictureRequested += OnPictureRequested;
            _host.SaveGameRequested += OnSaveRequested;
            _host.LoadGameRequested += OnLoadRequested;
            _host.ExitRequested += OnExitRequested;

            var size = await _module.InvokeAsync<BrowserSize>("getSize", _container);
            RequestBrowserResize(size.Width, size.Height);
            _host.Initialize(logLevel: LogLevel.Warning);

            // Spot.Blazor also creates its About images after host initialization.
            // A missing/unsupported logo must not prevent Slider or its menu from working.
            try
            {
                using var logoStream = new MemoryStream(logoData, writable: false);
                aboutLogo = global::SkiaSharp.SKImage.FromEncodedData(logoStream);
                if (aboutLogo is null)
                    Logger.LogWarning("Unable to decode Slider's Gondwana About logo; opening About without a logo.");
            }
            catch (Exception logoError)
            {
                Logger.LogWarning(logoError, "Unable to decode Slider's Gondwana About logo; opening About without a logo.");
            }

            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("watchSurface", _container, _dotNetRef);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to start Slider.Blazor");
            _notice = "Unable to start Slider: " + ex.Message;
            ReleaseHost();
        }
        finally
        {
            assets?.Dispose();
            _loading = false;
            if (!_disposed)
                StateHasChanged();
        }
    }

    private static IReadOnlyList<SliderScore> ReadStoredScores(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return [];

        try
        {
            return SliderPersistence.DeserializeScores(json);
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private void OnPictureRequested(int columns, int rows)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            _pictureColumns = columns;
            _pictureRows = rows;
            _picker = PickerMode.Picture;
            _focusPickerPending = true;
            _restoreCanvasFocusPending = false;
            StateHasChanged();
        });
    }

    private void OnLoadRequested()
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            _picker = PickerMode.SavedGame;
            _focusPickerPending = true;
            _restoreCanvasFocusPending = false;
            StateHasChanged();
        });
    }

    private void OnExitRequested() => ShowNotice("Close this browser tab to exit Slider.");

    private void OnSaveRequested(SliderSave save)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed || _module is null)
                return;

            try
            {
                string json = SliderPersistence.Serialize(save);
                if (System.Text.Encoding.UTF8.GetByteCount(json) > MaxSaveBytes)
                    throw new InvalidDataException("The saved puzzle exceeds the 64 MiB browser save limit.");

                await _module.InvokeVoidAsync("downloadSave", json);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Unable to download Slider save file");
                _notice = "Could not download puzzle: " + ex.Message;
                StateHasChanged();
            }
        });
    }

    private void SaveScoresInBrowser(string json)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed || _module is null)
                return;

            try
            {
                await _module.InvokeVoidAsync("saveScores", json);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Unable to persist Slider high scores");
                _notice = "High scores could not be saved in this browser.";
                StateHasChanged();
            }
        });
    }

    private async Task OnPictureSelected(InputFileChangeEventArgs args)
    {
        try
        {
            await using var file = args.File.OpenReadStream(MaxImageBytes);
            using var buffer = new MemoryStream();
            await file.CopyToAsync(buffer);
            _host?.RequestPuzzle(buffer.ToArray(), _pictureColumns, _pictureRows);
            ClosePicker();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException)
        {
            ShowNotice("Unable to read image: " + ex.Message);
        }
    }

    private async Task OnGameSelected(InputFileChangeEventArgs args)
    {
        try
        {
            await using var file = args.File.OpenReadStream(MaxSaveBytes);
            using var reader = new StreamReader(file);
            string json = await reader.ReadToEndAsync();
            _host?.RequestRestore(SliderPersistence.Deserialize(json));
            ClosePicker();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or UnauthorizedAccessException
            or InvalidDataException or JsonException or FormatException)
        {
            ShowNotice("Unable to load saved puzzle: " + ex.Message);
        }
    }

    private void ClosePicker()
    {
        _picker = PickerMode.None;
        _focusPickerPending = false;
        _restoreCanvasFocusPending = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void DismissPicker()
    {
        if (!_disposed && _picker != PickerMode.None)
            _ = InvokeAsync(ClosePicker);
    }

    private void ShowNotice(string message)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            _notice = message;
            StateHasChanged();
        });
    }

    private sealed class BrowserSize
    {
        // Explicit public constructor allows System.Text.Json interop deserialization.
        public BrowserSize() { }

        public int Width { get; set; }
        public int Height { get; set; }
    }

    private void RequestBrowserResize(int width, int height)
    {
        if (width <= 0 || height <= 0)
            return;

        // Preserve the full fixed-position Widgets sidebar on small screens.
        // CSS scales the 1200x780 logical canvas to the available viewport.
        _host?.RequestResize(new Size(Math.Max(MinLogicalWidth, width),
            Math.Max(MinLogicalHeight, height)));
    }

    [JSInvokable]
    public void UpdateSize(int width, int height)
    {
        if (!_disposed)
            RequestBrowserResize(width, height);
    }

    [JSInvokable]
    public void SetShiftFromBrowser(bool held)
    {
        if (!_disposed)
            _host?.SetShiftHeld(held);
    }

    private void ReleaseHost()
    {
        if (_host is null)
            return;

        _host.OpenPictureRequested -= OnPictureRequested;
        _host.SaveGameRequested -= OnSaveRequested;
        _host.LoadGameRequested -= OnLoadRequested;
        _host.ExitRequested -= OnExitRequested;
        _host.Dispose();
        _host = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        ReleaseHost();
        _dotNetRef?.Dispose();
        _dotNetRef = null;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopWatching");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Browser navigation can detach JavaScript before disposal.
            }
            _module = null;
        }
    }
}
