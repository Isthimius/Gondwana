<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gondwana.ZeldaPrototype</RootNamespace>
    <AssemblyName>Gondwana.ZeldaPrototype</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Prefer this repository's projects when the demo is built in-place. -->
    <GondwanaSourceRoot Condition="'$(GondwanaSourceRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Gondwana\Gondwana.csproj')">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..'))</GondwanaSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Standalone fallback: use the same NuGet packages as the WinForms template. -->
  <ItemGroup Condition="'$(GondwanaSourceRoot)' == ''">
    <PackageReference Include="Gondwana" Version="2.*" />
    <PackageReference Include="Gondwana.Hosting" Version="2.*" />
    <PackageReference Include="Gondwana.WinForms" Version="2.*" />
    <PackageReference Include="Gondwana.WinForms.Hosting" Version="2.*" />
  </ItemGroup>

  <!-- In-repository or explicitly selected checkout: compile against current source. -->
  <ItemGroup Condition="'$(GondwanaSourceRoot)' != ''">
    <ProjectReference Include="$(GondwanaSourceRoot)\Gondwana\Gondwana.csproj" />
    <ProjectReference Include="$(GondwanaSourceRoot)\Gondwana.Hosting\Gondwana.Hosting.csproj" />
    <ProjectReference Include="$(GondwanaSourceRoot)\Gondwana.WinForms\Gondwana.WinForms.csproj" />
    <ProjectReference Include="$(GondwanaSourceRoot)\Gondwana.WinForms.Hosting\Gondwana.WinForms.Hosting.csproj" />
  </ItemGroup>

</Project>
