@using Gondwana.Blazor.Rendering
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IJSRuntime JsRuntime
@inject ILogger<GameRenderSurface> Logger

<div class="render-surface-container" style="@PresentationStyle">
    <BlazorGpuRenderSurfaceComponent @ref="_surface" style="position:absolute;inset:0;" />
    @if (_loading)
    {
        <div class="status-overlay" role="status">Preparing Breakout...</div>
    }
    else if (_error is not null)
    {
        <div class="status-overlay error" role="alert">@_error</div>
    }
</div>

@code {
    private const int LogicalWidth = BreakoutGame.Width;
    private const int LogicalHeight = BreakoutGame.Height;
    private static readonly string PresentationStyle =
        $"width: min({LogicalWidth}px, 100vw, calc(100vh * {LogicalWidth} / {LogicalHeight})); " +
        $"width: min({LogicalWidth}px, 100vw, calc(100dvh * {LogicalWidth} / {LogicalHeight})); " +
        $"aspect-ratio: {LogicalWidth} / {LogicalHeight};";

    private BlazorGpuRenderSurfaceComponent? _surface;
    private BreakoutGameHost? _host;
    private bool _loading = true;
    private string? _error;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _surface is null) return Task.CompletedTask;

        try
        {
            _host = new BreakoutGameHost(_surface, JsRuntime);
            _host.Initialize(logLevel: LogLevel.Warning);
            _host.ConfigureLogicalResolution(LogicalWidth, LogicalHeight);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Breakout Blazor initialization failed");
            _host?.Dispose();
            _host = null;
            _error = "Could not start Breakout. See the browser console for details.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _host?.Dispose();
        _host = null;
    }
}
