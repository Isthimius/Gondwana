    <None Remove="assets\bubble-red.png" />
    <None Remove="assets\bubble-yellow.png" />
    <None Remove="assets\clouds_slice.png" />
    <None Remove="assets\sounovamusic-puzzle-amp-casual-game-music-460543.mp3" />
    <None Remove="assets\sounovamusic-puzzle-amp-casual-game-music-460543.txt" />
    <None Remove="assets\spot.png" />
    <None Remove="dorian.mid" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="assets\bubble-blue.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\bubble-green.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\bubble-pink.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\bubble-red.png">
